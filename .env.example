# Copy this file to .env and fill in real values for local development.
# .env is gitignored; this file documents the shape only (no real secrets).

# Flask session-signing key. Required for real use; a loud dev fallback is used if unset.
SECRET_KEY=change-me-to-a-random-string

# SQLAlchemy DB URI. Defaults to sqlite:///<repo-root>/glassbox.db if unset.
SQLALCHEMY_DATABASE_URI=sqlite:///glassbox.db

# Enable/disable Flask-WTF CSRF protection (true/false). Defaults to true.
WTF_CSRF_ENABLED=true

# Self-custody wallet address that receives crypto invoice payments.
CRYPTO_RECEIVING_ADDRESS=0xYOUR_RECEIVING_ADDRESS

# EVM chain used for invoicing/verification. Defaults to "polygon".
CRYPTO_CHAIN=polygon

# API key for Polygonscan's free-tier tokentx endpoint (used to verify incoming transfers).
POLYGONSCAN_API_KEY=your-polygonscan-api-key

# USDT token contract address on the configured chain.
USDT_CONTRACT_ADDRESS=0xUSDT_CONTRACT_ADDRESS

# USDC token contract address on the configured chain.
USDC_CONTRACT_ADDRESS=0xUSDC_CONTRACT_ADDRESS

# Minutes before an unpaid crypto invoice expires. Defaults to 60.
INVOICE_EXPIRY_MINUTES=60

# Minimum block confirmations required before an invoice payment counts as matched. Defaults to 5.
INVOICE_MIN_CONFIRMATIONS=5

# Email delivery mode. "console" (default) prints emails to stdout instead of sending real mail.
EMAIL_MODE=console
